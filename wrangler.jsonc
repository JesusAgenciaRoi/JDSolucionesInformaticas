{
  // Sitio estático servido por Cloudflare (Workers con assets).
  // "single-page-application" hace que /proyectos/..., /admin y /cuestionario/... carguen index.html al recargar.
  // Antes de publicar hay que compilar (npm run build): usá "npm run deploy", que hace las dos cosas.
  "name": "jdsolucionesinformaticas",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
